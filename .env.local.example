# Copy to .env.local for local development (never commit .env.local).
# On Vercel: Project → Settings → Environment Variables (Production + Preview).
# Full walkthrough: SUPABASE_SETUP.md

# -----------------------------------------------------------------------------
# Required for the Next.js app
# -----------------------------------------------------------------------------

# Project URL, e.g. https://abcdefghijklmnop.supabase.co  (no /rest/v1/)
NEXT_PUBLIC_SUPABASE_URL=

# Public anon / publishable key (browser-safe; RLS still applies)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret service_role / secret key — SERVER ONLY. Never commit or expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Site URL for auth redirects (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Required for npm run setup:supabase
# -----------------------------------------------------------------------------

# Postgres connection string — Project Settings → Database → Connection string
# (URI). Prefer "Session mode" / direct connection. Replace [YOUR-PASSWORD]
# with the database password you set when creating the project.
# Example:
# postgresql://postgres.xxxxx:YOUR_PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres
# or:
# postgresql://postgres:YOUR_PASSWORD@db.xxxxx.supabase.co:5432/postgres
SUPABASE_DB_URL=

# Personal access token for Management API (auth config automation).
# Create at: https://supabase.com/dashboard/account/tokens
# Needed by: npm run db:configure-auth / setup:supabase
SUPABASE_ACCESS_TOKEN=

# Bootstrap admin (required by npm run db:create-admin / setup:supabase).
# Use a strong unique password. Never commit real values.
ADMIN_EMAIL=
ADMIN_PASSWORD=
