# Copy to .env.local for local development.
# On Vercel: Project → Settings → Environment Variables (Production + Preview).

# Public site URL — no trailing slash
# Local:  http://localhost:3000
# Live:   https://yourdomain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — optional for the soft-launch marketing site.
# Leave blank on Vercel until Auth/DB are ready; middleware skips safely.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
